{
  "name": "cluys/ivy-demo-template",
  "description": "Demo sub template for ivy CMS",
  "type": "ivy-template",
  "license": "MIT",
  "authors": [
    {
      "name": "Joep Dooper"
    }
  ],
  "require": {
    "php": ">=8.5.6"
  },
  "extra": {
    "ivy": {
      "name": "Demo",
      "type": "sub",
      "interface": "Cluys\\Template\\Demo\\DemoTemplate"
    }
  },
  "autoload": {
    "psr-4": {
      "Cluys\\Template\\Demo\\": "classes/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
